<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Furever Home</title>
    <link rel="icon" type="image/png" href="/images/FureverHomeIcon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/furever_home.styles.css" asp-append-version="true" />
    <style>
        .navbar .nav-link {
            color: #2f3e34;
        }
        .navbar .nav-link:hover {
            color: #1f2d24;
        }
        .navbar .nav-link.active {
            color: #1f2d24;
            font-weight: 600;
        }
        .navbar-toggler {
            border-color: #2f3e34;
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml;charset=utf8,%3Csvg viewBox='0 0 30 30' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath stroke='rgba(31, 45, 36, 1)' stroke-width='2' stroke-linecap='round' stroke-miterlimit='10' d='M4 7h22M4 15h22M4 23h22'/%3E%3C/svg%3E");
        }
        .footer-title {
           color: #1f2d24;
        }
        .footer-link {
           color: #2f3e34;
        } 
        .btn-login {
            border: 1px solid #2f3e34;
            color: #2f3e34;
            background: transparent;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        .btn-login:hover {
            background-color: #2f3e34;
            color: #ffffff;
        }
        .btn-signup {
            background-color: #2f3e34;
            color: #ffffff;
            border: 1px solid #2f3e34;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        .btn-signup:hover {
            background-color: #1f2d24;
            border-color: #1f2d24;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color: #ACD1AF;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/FureverHomeLogo.png" height="60" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="">Shelters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="">Pets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="">Donate</a>
                        </li>
                    </ul>
                    <div class="ms-auto d-flex flex-column flex-md-row">
                        <a href="#" class="btn btn-login me-2">Log in</a>
                        <a class="btn btn-signup" asp-controller="Account" asp-action="Register">Sign up</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-success py-4" style="background-color: #ACD1AF !important;">
      <div class="container-fluid">
        <div class="row g-4 pb-4 border-bottom border-success">
    
          <div class="col-12 col-md-6">
            <img src="~/images/FureverHomeLogo.png" height="60" alt="Furever Home" class="mb-2">
            <p class="small footer-link">
              Connecting animal shelters with loving families across the Philippines.
            </p>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3 footer-title">Platform</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a href="#" class="text-decoration-none small footer-link">Browse shelters</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small footer-link">Browse pets</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small footer-link">How it works</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small footer-link">Register your shelter</a></li>
            </ul>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3 footer-title">Account</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a asp-action="Register" asp-controller="Account" class="text-decoration-none small footer-link">Sign up</a></li>
              <li class="mb-2"><a asp-action="Login" asp-controller="Account" class="text-decoration-none small footer-link">Log in</a></li>
              <li class="mb-2"><a asp-action="MyApplications" asp-controller="Adoption" class="text-decoration-none small footer-link">My applications</a></li>
              <li class="mb-2"><a asp-action="MyAppointments" asp-controller="Appointment" class="text-decoration-none small footer-link">My appointments</a></li>
            </ul>
          </div>
    
        </div>
    
        <div class="d-flex justify-content-between align-items-center pt-3 flex-wrap gap-2">
          <p class="small mb-0 footer-title">© 2026 Furever Home. All rights reserved.</p>
          <div class="d-flex gap-3">
            <a asp-controller="Home" asp-action="About" class="text-decoration-none small footer-link">About</a>
            <a href="#" class="text-decoration-none small footer-link">Contact</a>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none small footer-link">Privacy</a>
            <a href="#" class="text-decoration-none small footer-link">Terms</a>
          </div>
        </div>
    
      </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
