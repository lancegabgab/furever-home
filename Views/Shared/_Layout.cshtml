<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Furever Home</title>
    <link rel="icon" type="image/png" href="/images/FureverHomeIcon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/swal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/furever_home.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/FureverHomeLogo.png" height="60" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Shelter" asp-action="Index">Shelters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Pet" asp-action="Index">Pets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Donate">Donate</a>
                        </li>
                    </ul>
                    <div class="ms-auto d-flex flex-column flex-md-row">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a class="btn btn-brand-outline me-2" asp-controller="Account" asp-action="Index">
                                <i class="bi bi-person-fill me-1"></i>Profile
                            </a>

                            <a class="btn btn-brand" id="btnLogout"> Logout</a>
                        }
                        else
                        {
                            <a class="btn btn-brand-outline me-2" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid p-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4">
      <div class="container-fluid">
        <div class="row g-4 pb-4 border-bottom border-success">
    
          <div class="col-12 col-md-6">
            <img src="~/images/FureverHomeLogo.png" height="60" alt="Furever Home" class="mb-2">
            <p class="small footer-link">
              Connecting animal shelters with loving families across the Philippines.
            </p>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3 footer-title">Platform</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a asp-action="Index" asp-controller="Shelter" class="text-decoration-none small footer-link">Browse shelters</a></li>
              <li class="mb-2"><a asp-action="Index" asp-controller="Pet" class="text-decoration-none small footer-link">Browse pets</a></li>
              <li class="mb-2"><a asp-action="Index" asp-controller="Home" asp-fragment="how-it-works" class="text-decoration-none small footer-link">How it works</a></li>
              <li class="mb-2"><a asp-action="Index" asp-controller="Shelter" asp-fragment="register-shelter" class="text-decoration-none small footer-link">Register your shelter</a></li>
            </ul>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3 footer-title">Account</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a asp-action="Register" asp-controller="Account" class="text-decoration-none small footer-link">Sign up</a></li>
              <li class="mb-2"><a asp-action="Login" asp-controller="Account" class="text-decoration-none small footer-link">Log in</a></li>
            </ul>
          </div>
    
        </div>
    
        <div class="d-flex justify-content-between align-items-center pt-3 flex-wrap gap-2">
          <p class="small mb-0 footer-title">© @DateTime.Now.Year Furever Home. All rights reserved.</p>
          <div class="d-flex gap-3">
            <a asp-controller="Home" asp-action="About" class="text-decoration-none small footer-link">About</a>
            <a asp-controller="Home" asp-action="FAQ" class="text-decoration-none small footer-link">FAQ</a>
            <a asp-controller="Home" asp-action="Contact" class="text-decoration-none small footer-link">Contact</a>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none small footer-link">Privacy</a>
            <a asp-controller="Home" asp-action="Terms" class="text-decoration-none small footer-link">Terms</a>
          </div>
        </div>
    
      </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
