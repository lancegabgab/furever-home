<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Furever Home</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/furever_home.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/FureverHome.png" height="60" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="">Shelters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="">Pets</a>
                        </li>
                    </ul>
                    <div class="ms-auto">
                        <a href="#" class="btn btn-outline-primary me-2">Log in</a>
                        <a href="#" class="btn btn-primary">Sign up</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-success py-4" style="background-color: #04342C !important;">
      <div class="container-fluid">
        <div class="row g-4 pb-4 border-bottom border-success">
    
          <div class="col-12 col-md-6">
            <img src="~/images/FureverHome.png" height="60" alt="Furever Home" class="mb-2">
            <p class="small" style="color: #5DCAA5;">
              Connecting animal shelters with loving families across the Philippines.
            </p>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3" style="color: #9FE1CB;">Platform</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Browse shelters</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Browse pets</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small" style="color: #5DCAA5;">How it works</a></li>
              <li class="mb-2"><a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Register your shelter</a></li>
            </ul>
          </div>
    
          <div class="col-6 col-md-3">
            <h6 class="small fw-medium mb-3" style="color: #9FE1CB;">Account</h6>
            <ul class="list-unstyled">
              <li class="mb-2"><a asp-action="Register" asp-controller="Account" class="text-decoration-none small" style="color: #5DCAA5;">Sign up</a></li>
              <li class="mb-2"><a asp-action="Login" asp-controller="Account" class="text-decoration-none small" style="color: #5DCAA5;">Log in</a></li>
              <li class="mb-2"><a asp-action="MyApplications" asp-controller="Adoption" class="text-decoration-none small" style="color: #5DCAA5;">My applications</a></li>
              <li class="mb-2"><a asp-action="MyAppointments" asp-controller="Appointment" class="text-decoration-none small" style="color: #5DCAA5;">My appointments</a></li>
            </ul>
          </div>
    
        </div>
    
        <div class="d-flex justify-content-between align-items-center pt-3 flex-wrap gap-2">
          <p class="small mb-0" style="color: #5DCAA5;">© 2026 Furever Home. All rights reserved.</p>
          <div class="d-flex gap-3">
            <a asp-controller="Home" asp-action="About" class="text-decoration-none small" style="color: #5DCAA5;">About</a>
            <a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Contact</a>
            <a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Privacy</a>
            <a href="#" class="text-decoration-none small" style="color: #5DCAA5;">Terms</a>
          </div>
        </div>
    
      </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
