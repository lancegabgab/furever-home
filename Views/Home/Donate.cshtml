@{
    ViewData["Title"] = "Donate";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Support Furever Home</h1>
        <p class="text-muted">
            Your support helps us maintain our platform, including website hosting, database infrastructure,
            and continuous improvements to better connect rescued pets with loving homes.
        </p>
    </div>

    <div class="text-center mb-4">
        <h1 class="fw-bold">Choose a Shelter to Donate To</h1>
        <p class="text-muted">
            Select a shelter you'd like to support. Your contribution helps sustain rescue efforts, care, and shelter operations.
        </p>
    </div>

    <div class="bg-light rounded-4 p-5 my-5">
        <div class="row text-center">
    
            <div class="col-md-4 mb-4 mb-md-0">
                <div class="fs-1 mb-3">🐾</div>
                <h5 class="fw-bold">Support Rescue Efforts</h5>
                <p class="text-muted mb-0">
                    Donations help provide rescued animals with food, medical care, and a safe place while they wait for their forever homes.
                </p>
            </div>
    
            <div class="col-md-4 mb-4 mb-md-0">
                <div class="fs-1 mb-3">🏡</div>
                <h5 class="fw-bold">Empower Local Shelters</h5>
                <p class="text-muted mb-0">
                    Every contribution supports shelters in caring for more animals and continuing their rescue and adoption programs.
                </p>
            </div>
    
            <div class="col-md-4">
                <div class="fs-1 mb-3">❤️</div>
                <h5 class="fw-bold">Make a Lasting Impact</h5>
                <p class="text-muted mb-0">
                    Even a small donation can make a meaningful difference in the lives of rescued pets and the organizations that care for them.
                </p>
            </div>
    
        </div>
    </div>

</div>
