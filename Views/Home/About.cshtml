@{
    ViewData["Title"] = "About Us";
}
<div class="container my-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">About Furever Home</h1>
        <p class="lead text-muted">Helping pets find their forever families 🐾</p>
    </div>

    <div class="mb-5">
        <h3 class="fw-bold mb-3">🐶 Who We Are</h3>
        <p>
            <strong>Furever Home</strong> is a pet adoption platform dedicated to connecting rescued animals
            with loving and responsible families. We collaborate with animal shelters, rescue groups,
            and foster networks to give every pet the chance to find a safe and permanent home.
        </p>
    </div>

    <div class="mb-5">
        <h3 class="fw-bold mb-3">🐾 What We Do</h3>
        <p>
            Our platform simplifies the adoption process by making it more transparent and accessible.
            With just a few clicks, users can browse available pets, learn more about each pet and their unique traits, and
            take the first step toward giving them a better life.
        </p>
    </div>

    <div class="card shadow-sm border-0 p-4 mb-5 bg-light">
        <h4 class="fw-bold mb-3 text-center">💛 Our Mission</h4>
        <p class="mb-0 text-center">
            To make pet adoption easier and more accessible for everyone—so more animals can move
            from rescue situations into their <strong>forever homes</strong>.
        </p>
    </div>

</div>