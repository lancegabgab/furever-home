@{
    ViewData["Title"] = "Terms";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Terms and Conditions</h1>
        <p class="text-muted">
            Please read these terms carefully before using Furever Home.
        </p>
    </div>

    <div class="mb-4">
        <h4>1. Acceptance of Terms</h4>
        <p>
            By accessing or using Furever Home, you agree to comply with
            these Terms and Conditions. If you do not agree, please do not
            use our platform.
        </p>
    </div>

    <div class="mb-4">
        <h4>2. Purpose of the Platform</h4>
        <p>
            Furever Home is a platform designed to help connect rescued pets,
            shelters, and adopters. We aim to provide information that helps
            pets find safe and loving homes.
        </p>
    </div>

    <div class="mb-4">
        <h4>3. User Responsibilities</h4>
        <p>
            Users are responsible for providing accurate information when
            submitting adoption inquiries, donations, or account details.
            Misuse of the platform, fraudulent activity, or harmful behavior
            is strictly prohibited.
        </p>
    </div>

    <div class="mb-4">
        <h4>4. Pet Information Disclaimer</h4>
        <p>
            Furever Home works with shelters and rescue organizations.
            Information regarding pets, including health, age, breed, and
            availability, is provided by shelters and may change over time.
            We do not guarantee the accuracy of all listings.
        </p>
    </div>

    <div class="mb-4">
        <h4>5. Adoption Responsibility</h4>
        <p>
            Adoption decisions are made between adopters and shelters.
            Furever Home is not responsible for agreements, pet behavior,
            medical conditions, or adoption outcomes.
        </p>
    </div>

    <div class="mb-4">
        <h4>6. Donations</h4>
        <p>
            Donations made through or related to Furever Home are intended
            to support shelters and rescued animals. Users should verify
            donation details before proceeding.
        </p>
    </div>

    <div class="mb-4">
        <h4>7. Intellectual Property</h4>
        <p>
            All website content, including text, logos, images, and design,
            belongs to Furever Home unless otherwise stated. Unauthorized
            copying or misuse is prohibited.
        </p>
    </div>

    <div class="mb-4">
        <h4>8. Limitation of Liability</h4>
        <p>
            Furever Home is provided on an "as is" basis. We are not liable
            for damages, losses, or issues resulting from the use of this
            platform or interactions between users and shelters.
        </p>
    </div>

    <div class="mb-4">
        <h4>9. Changes to Terms</h4>
        <p>
            We reserve the right to update these Terms and Conditions at any
            time. Updates will be posted on this page.
        </p>
    </div>

    <div>
        <h4>10. Contact Us</h4>
        <p>
            If you have questions about these Terms and Conditions, please
            contact us through our website or support channels.
        </p>
    </div>

    <p class="text-muted mt-5 small">
        Last updated: June 2026
    </p>
</div>