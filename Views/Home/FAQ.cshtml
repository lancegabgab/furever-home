@{
    ViewData["Title"] = "FAQ";

    var faqSections = new[]
    {
        new
        {
            Title = "Adoption Questions",
            Items = new[]
            {
                new { 
                    Question = "How do I adopt?", 
                    Answer = "Browse available pets, choose your preferred pet, and submit an adoption request through the system." 
                },
                new { 
                    Question = "What are the available options for getting my adopted pet?", 
                    Answer = "Upon completing the adoption form, you may choose one of the following adoption methods: shelter pickup, meetup at an agreed location, or home delivery, depending on the shelter's availability." 
                }
            }
        },
        new
        {
            Title = "Account Questions",
            Items = new[]
            {
                new { 
                    Question = "How do I create an account?", 
                    Answer = "Click register and fill out the required information." 
                },
                new { 
                    Question = "I forgot my password.", 
                    Answer = "Use the forgot password option on the login page." 
                }
            }
        },
        new
        {
            Title = "Donation Questions",
            Items = new[]
            {
                new { 
                    Question = "Do registered shelters have to donate for platform deployment?", 
                    Answer = "Not at all. Donations are voluntary, but greatly appreciated if you’d like to support us." 
                },
                new {
                    Question = "Can I choose which shelter to donate to?",
                    Answer = "Yes. Simply go to the Donate tab in the app, scroll down to view the list of available shelters, and choose the one you would like to support." 
                },
                new {
                    Question = "If I donate to a specific shelter, will my donation go directly to them?",
                    Answer = "Yes. Donations made to a selected shelter are allocated directly to that shelter to support their animals, operational needs, and rescue efforts."
                }
            }
        }
    };
}
<style>
    .custom-accordion .accordion-button {
        background-color: #eaf5ea;
        color: #2f3e34;
        box-shadow: none;
    }
</style>
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Frequently Asked Questions</h1>
        <p class="text-muted">
            Find answers to common questions about pet adoption and our system.
        </p>
    </div>

    <div class="accordion custom-accordion" id="mainAccordion">
        @for (int i = 0; i < faqSections.Length; i++)
        {
            var faqSection = faqSections[i];
    
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(i != 0 ? "collapsed" : "")"
                            data-bs-toggle="collapse"
                            data-bs-target="#parent@(i)">
                        @faqSection.Title
                    </button>
                </h2>
    
                <div id="parent@(i)"
                     class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                     data-bs-parent="#mainAccordion">
    
                    <div class="accordion-body">
                        <div class="accordion" id="nestedAccordion@(i)">
                            @for (int j = 0; j < faqSection.Items.Length; j++)
                            {
                                var item = faqSection.Items[j];
    
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#child@(i)_@(j)">
                                            @item.Question
                                        </button>
                                    </h2>
    
                                    <div id="child@(i)_@(j)"
                                         class="accordion-collapse collapse"
                                         data-bs-parent="#nestedAccordion@(i)">
                                        <div class="accordion-body">
                                            @item.Answer
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
    
                </div>
            </div>
        }
    </div>
</div>
