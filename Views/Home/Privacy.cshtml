@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Privacy Policy</h1>
        <p class="text-muted">
            Your privacy matters to us at Furever Home.
        </p>
    </div>

    <div class="mb-4">
        <h4>1. Information We Collect</h4>
        <p>
            Furever Home may collect personal information when you register,
            submit adoption inquiries, donate, or contact shelters. This
            information may include your name, email address, phone number,
            and other details needed to provide our services.
        </p>
    </div>

    <div class="mb-4">
        <h4>2. How We Use Your Information</h4>
        <p>
            We use the information collected to help connect rescued pets with
            loving homes, process adoption requests, improve our platform, and
            communicate important updates regarding pet adoptions and shelter
            activities.
        </p>
    </div>

    <div class="mb-4">
        <h4>3. Data Protection</h4>
        <p>
            We take reasonable measures to protect your personal information
            from unauthorized access, misuse, or disclosure. However, no
            online platform can guarantee complete security.
        </p>
    </div>

    <div class="mb-4">
        <h4>4. Sharing of Information</h4>
        <p>
            Furever Home does not sell personal information. We may share
            necessary information with partner shelters only when required to
            process adoption requests or related services.
        </p>
    </div>

    <div class="mb-4">
        <h4>5. Cookies and Analytics</h4>
        <p>
            Our website may use cookies or analytics tools to improve user
            experience and better understand website usage.
        </p>
    </div>

    <div class="mb-4">
        <h4>6. Your Rights</h4>
        <p>
            You may request access, updates, or deletion of your personal
            information by contacting us through our support channels.
        </p>
    </div>

    <div class="mb-4">
        <h4>7. Changes to This Policy</h4>
        <p>
            Furever Home reserves the right to update this Privacy Policy at
            any time. Changes will be posted on this page.
        </p>
    </div>

    <div>
        <h4>8. Contact Us</h4>
        <p>
            If you have any questions regarding this Privacy Policy, please
            contact us through our website or support email.
        </p>
    </div>

    <p class="text-muted mt-5 small">
        Last updated: June 2026
    </p>
</div>
