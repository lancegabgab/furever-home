@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section d-flex align-items-center justify-content-center text-center text-white">
    <h1 class="display-4 fw-bolder mb-3">Find Your Furever Friend</h1>
    <p class="lead mb-4"> Hundreds of loving animals are waiting for a home. Browse shelter pets, book a visit, or begin your adoption journey today.</p>
    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">Browse Pets</button>
    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">Book an appointment</button>
</div>

<div class="container-fluid bg-white border-bottom">
    <div class="row text-center">
        <div class="col-6 py-3 border-end">
            <div class="fs-4 fw-medium text-success">240+</div>
            <div class="text-muted small">Pets available</div>
        </div>
        <div class="col-6 py-3">
            <div class="fs-4 fw-medium text-success">100+</div>
            <div class="text-muted small">Happy adoptions</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    <div class="row justify-content-center align-items-center gap-4 p-4" style="background-color:#FFE0B2;">

        <div class="col-auto">
            <select name="PetType" class="form-select">
                <option value="">Pet Type</option>
                <option value="1">Cat</option>
                <option value="2">Dog</option>
            </select>
        </div>

        <div class="col-auto">
            <select name="PetGender" class="form-select">
                <option value="">Pet Gender</option>
                <option value="1">Male</option>
                <option value="2">Female</option>
            </select>
        </div>

        <div class="col-auto">
            <button class="btn text-white px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">
                Search
            </button>
        </div>

    </div>
</div>
<style>
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                    url('/images/strays.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    
        min-height: 80vh;   
}
</style>
