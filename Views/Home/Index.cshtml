@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section d-flex align-items-center text-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="text-warning fw-semibold mb-2">
                    Adopting a shelter pet won’t change the world, but it will change the world for that one pet.
                </p>
                <h1 class="display-4 fw-bolder mb-3">
                    Give a Pet a Forever Home
                </h1>
                <p class="lead mb-4">
                    Hundreds of loving animals from various shelters are waiting for a home. Browse available pets and find your perfect companion today.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm border-0 text-white" style="background-color:#4CAF50;">
                        Browse Pets
                    </button>
                    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm border-0 text-dark" style="background-color:#FFA726;">
                        Learn More
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid bg-white border-bottom">
    <div class="row text-center">
        <div class="col-6 py-3 border-end">
            <div class="fs-4 fw-medium text-success">240+</div>
            <div class="text-muted small">Pets available</div>
        </div>
        <div class="col-6 py-3">
            <div class="fs-4 fw-medium text-success">100+</div>
            <div class="text-muted small">Happy adoptions</div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                    url('/images/AdoptedDog.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    
        min-height: 80vh;   
}
</style>
