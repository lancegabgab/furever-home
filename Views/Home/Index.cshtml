@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section d-flex align-items-center text-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bolder mb-3">Find Your Furever Friend</h1>
                <p class="lead mb-4">Hundreds of loving animals across different shelters are waiting for a home. Browse shelters, view available pets, book a visit, and start your adoption journey today.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm border-0 text-white" style="background-color:#4CAF50;">
                        Browse Shelters
                    </button>
                    <button class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm border-0 text-white" style="background-color:#FFA726;">
                        Book a Visit
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid bg-white border-bottom">
    <div class="row text-center">
        <div class="col-6 py-3 border-end">
            <div class="fs-4 fw-medium text-success">240+</div>
            <div class="text-muted small">Pets available</div>
        </div>
        <div class="col-6 py-3">
            <div class="fs-4 fw-medium text-success">100+</div>
            <div class="text-muted small">Happy adoptions</div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                    url('/images/strays.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    
        min-height: 80vh;   
}
</style>
