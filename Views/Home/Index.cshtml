@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4 text-black fw-bolder">Find Your Furever Friend</h1>
    <button class="btn rounded-pill text-white px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">Browse Pets</button>
    <button class="btn rounded-pill text-white px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">Book an appointment</button>
</div>

<div class="container-fluid mt-3">
    <div class="row justify-content-center align-items-center gap-4 p-4" style="background-color:#FFE0B2;">

        <div class="col-auto">
            <select name="PetType" class="form-select">
                <option value="">Pet Type</option>
                <option value="1">Cat</option>
                <option value="2">Dog</option>
            </select>
        </div>

        <div class="col-auto">
            <select name="PetGender" class="form-select">
                <option value="">Pet Gender</option>
                <option value="1">Male</option>
                <option value="2">Female</option>
            </select>
        </div>

        <div class="col-auto">
            <button class="btn text-white px-4 py-2 fw-semibold shadow-sm" style="background-color:#FF6B6B; border:none;">
                Search
            </button>
        </div>

    </div>
</div>
