@{
    ViewData["Title"] = "Home Page";
}
<style>
    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/adopted.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 80vh;
    }
</style>
<div class="hero-section d-flex align-items-center text-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-3 fw-bolder my-5">
                    Give a Pet a Forever Home
                </h1>
                <p class="lead my-5">
                    Hundreds of loving animals from various shelters are waiting for a home. Browse available pets and find your perfect companion today.
                </p>
                <a asp-action="Index" asp-controller="Pet" class="btn rounded-pill px-4 py-2 fw-semibold shadow-sm border-0 text-white" style="background-color:#4CAF50;">
                    Browse Pets
                </a>
            </div>
        </div>
    </div>
</div>

<div class="my-5" id="why-adopt">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-md-12">

                <span class="text-uppercase fw-bold text-primary small">
                    Why Adopt?
                </span>

                <h2 class="display-6 fw-bold mt-2 mb-3">
                    Give a Pet a Second Chance
                </h2>

                <p class="text-secondary mb-4">
                    Every pet deserves a loving home. By adopting, you're not
                    just gaining a companion — you're giving a pet the chance
                    to have a better life.
                </p>

                <div class="d-flex flex-column gap-3 mb-4">

                    <div class="d-flex gap-3">
                        <div class="fs-3">❤️</div>

                        <div>
                            <h5 class="fw-bold mb-1">Save a Life</h5>
                            <p class="text-secondary mb-0">
                                Give a homeless pet a second chance.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="fs-3">🏠</div>

                        <div>
                            <h5 class="fw-bold mb-1">Find Your Companion</h5>
                            <p class="text-secondary mb-0">
                                Build a meaningful bond with your new best friend.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="fs-3">🐾</div>

                        <div>
                            <h5 class="fw-bold mb-1">Make a Difference</h5>
                            <p class="text-secondary mb-0">
                                Help create a better future for animals in need.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

<div class="py-5 bg-light" id="how-it-works">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-6">
                🐾 How Furever Home Works
            </h2>
            <p class="text-muted">
                Give rescued pets a second chance at a loving home.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">1️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Browse Pets
                    </h5>
                    <p class="text-muted mb-0">
                        Explore adorable pets waiting for a loving family.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">2️⃣</div>
                    <h5 class="fw-bold mb-2">
                        View Pet Details
                    </h5>
                    <p class="text-muted mb-0">
                        Learn about them, their personality, health, and story.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">3️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Submit Adoption Request
                    </h5>
                    <p class="text-muted mb-0">
                        Fill out an adoption form to express your interest.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">4️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Welcome Your Pet
                    </h5>
                    <p class="text-muted mb-0">
                        Complete the process and give your pet a forever home.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>



