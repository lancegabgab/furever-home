@model IEnumerable<FureverHome.Models.Pet>
@{
    ViewData["Title"] = "Pets";
}
<style>
    #pet-banner-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/shelterdog.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 80vh;
    }
</style>
<div class="container-fluid">
    <div class="text-center mb-5">
        <div id="pet-banner-section" class="d-flex flex-column justify-content-center align-items-center text-white">
            <h1 class="display-3 fw-bold">Adopt a Pet</h1>
            <p class="text-white text-center lead">
                Find your perfect companion. Explore pets waiting for a loving home and connect with the shelters caring for them.
            </p>

            <form method="get" asp-controller="Pet" asp-action="Index" class="mb-4">
                <div class="row g-2 align-items-end">

                    <div class="col-md-3">
                        <input type="text" name="search" class="form-control" placeholder="Search pets..."
                               @* value="@Context.Request.Query["search"]"  *@
                    />
                    </div>

                    <div class="col-md-3">
                        <select name="petType" class="form-select">
                            <option value="" selected>All Pet Type</option>
                            <option value="1">Dog</option>
                            <option value="2">Cat</option>
                            @* <option value="Cat" selected="@(Context.Request.Query["petType"] == "Cat")">Cat</option>
                        <option value="Dog" selected="@(Context.Request.Query["petType"] == "Dog")">Dog</option> *@

                        </select>
                    </div>

                    <div class="col-md-3">
                        <select name="petGender" class="form-select" aria-label="Pet Gender">
                            <option value="">All Gender</option>
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn w-100" style="background-color:#4CAF50;">
                            Search
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
    <div class="container my-5"> 
        <div class="row g-4"> 
            @if (Model != null && Model.Any()) {
                @foreach (var pet in Model) {
                    <div class="col-md-4"> 
                        <div class="card h-100 shadow-sm"> 
                            <div class="d-flex align-items-center justify-content-center bg-secondary text-white" style="height:250px;">
                                <span>No Image Available</span> 
                            </div> 
                            <div class="card-body"> 
                                <h5 class="card-title">@pet.Name</h5> 
                            </div>
                            <div class="card-footer bg-white border-0">
                                <a asp-controller="Pet" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-success w-100"> View Details </a> 
                            </div> 
                        </div> 
                    </div>
                }
            } else
            {
                <div class="col-12 text-center"> 
                    <h4>No pets found.</h4> 
                </div>
            }
        </div>
    </div>
</div>
