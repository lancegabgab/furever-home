@{
    ViewData["Title"] = "Pets";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<style>
    #pet-banner-section {
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/shelterdog.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 80vh;
    }
</style>
<div class="container-fluid p-0">
    <div class="text-center mb-5">
        <div id="pet-banner-section" class="d-flex flex-column justify-content-center align-items-center text-white">
            <h1 class="display-4 fw-bold">Find your perfect companion today💚</h1>
            <p class="text-white text-center lead">
                 Explore pets waiting for a loving home and connect with the shelters caring for them.
            </p>
            <div class="card m-3">
                <div class="row g-2 align-items-end m-3">

                    <div class="col-md-3">
                        <input type="text" id="search" name="search" class="form-control" placeholder="Search pets..."   />
                    </div>

                    <div class="col-md-3">
                        <select name="petType" class="form-select">
                            <option value="" selected>All Pet Type</option>
                            <option value="1">Dog</option>
                            <option value="2">Cat</option>

                        </select>
                    </div>

                    <div class="col-md-3">
                        <select name="petGender" class="form-select" aria-label="Pet Gender">
                            <option value="">All Gender</option>
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button class="btn w-100 btn-brand-light">
                            Search
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="container my-5" id="petList">
        <div class="row g-4" id="petContainer">
        </div>
    </div>
</div>
