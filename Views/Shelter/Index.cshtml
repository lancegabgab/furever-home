@model IEnumerable<FureverHome.Models.Shelter>
@{
    ViewData["Title"] = "Shelters";
}

<div class="container-fluid">

    <div id="register-shelter" class="bg-light p-5">
        <div class="row g-4">
            <div class="text-center">
                <h1 class="fw-bold">Become Our Shelter Partner</h1>
                <p class="text-muted">
                    Register your shelter with Furever Home to manage pet profiles, streamline adoption processes, and reach more potential adopters.
                </p>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">1️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Create an Account
                    </h5>
                    <p class="text-muted mb-0">
                        Sign up and provide your basic information to get started.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">2️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Go to Your Profile Page
                    </h5>
                    <p class="text-muted mb-0">
                        Complete your profile details before registering your shelter.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">3️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Register Your Shelter
                    </h5>
                    <p class="text-muted mb-0">
                        Submit your shelter information and required details for review.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                    <div class="fs-1 mb-3">4️⃣</div>
                    <h5 class="fw-bold mb-2">
                        Wait for Admin Approval
                    </h5>
                    <p class="text-muted mb-0">
                        Our team will verify your shelter and notify you once approved.
                    </p>
                </div>
            </div>

        </div>
    </div>

    <div class="text-center my-5">
        <h1 class="fw-bold">Our Shelter Partners</h1>
        <p class="text-muted">
            These shelters actively use the Furever Home platform to manage pet listings, streamline adoption processes, and connect rescued animals with potential adopters.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted mt-4">
            No shelters available yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var shelter in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 p-4 text-center">
        
                        <img src="https://placehold.co/120x120?text=Logo"
                             class= mx-auto mb-3 border"
                             alt="Shelter Logo"
                             width="120"
                             height="120" />
        
                        <h5 class="fw-bold mb-2">@shelter.Name</h5>
        
                        <p class="text-muted small mb-0">
                            Verified Shelter Partner
                        </p>
        
                    </div>
                </div>
            }
        </div>
    }

</div>
