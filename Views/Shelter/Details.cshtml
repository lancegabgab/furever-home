@{
    ViewData["Title"] = "Shelter Details";
}

<div class="container py-5">

    <div class="row g-5">

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="bg-light d-flex justify-content-center align-items-center"
                     style="height:400px;">
                    <span class="text-muted fs-5">Shelter Logo</span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">

            <h1 class="fw-bold">Shelter Name </h1>

            <p class="text-muted mb-4">
                Address
            </p>

            <table class="table">
                <tbody>
                    <tr>
                        <th width="30%">Email</th>
                        <td>Email val</td>
                    </tr>

                    <tr>
                        <th>Phone</th>
                        <td>Phone val</td>
                    </tr>

                    <tr>
                        <th>Address</th>
                        <td>Address val</td>
                    </tr>

                    <tr>
                        <th>Operating Hours</th>
                        <td>Monday - Saturday | 8:00 AM - 5:00 PM</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4">
                <h4>About the Shelter</h4>

                <p class="text-muted">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Sed do eiusmod tempor incididunt ut labore et dolore magna
                    aliqua. Ut enim ad minim veniam, quis nostrud exercitation
                    ullamco laboris nisi ut aliquip ex ea commodo consequat.
                </p>
            </div>

            <a asp-controller="Shelter" asp-action="Index" class="btn btn-outline-secondary btn-lg mt-3">
                Back to Shelters
            </a>

        </div>

    </div>

    <hr class="my-5">

    <h2 class="fw-bold mb-4">Available Pets</h2>

    <div class="row g-4">
        
    </div>

</div>
