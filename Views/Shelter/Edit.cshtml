@{
    ViewData["Title"] = "Edit Shelter";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">

                    <h1 class="fw-bold mb-2">
                        Edit Shelter
                    </h1>

                    <p class="text-muted mb-4">
                        Update your shelter information.
                    </p>

                    <form>

                        <div class="mb-3">
                            <label class="form-label fw-semibold"> Shelter Name </label>
                            <input class="form-control" value="Happy Tails Animal Shelter" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold"> Shelter Logo </label>
                            <input type="file" class="form-control" />
                            <div class="form-text">
                                Leave blank to keep the current logo.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold"> Email Address </label>
                            <input type="email" class="form-control" value="Email val" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold"> Contact Number </label>
                            <input class="form-control" value="091xxxxxxxx" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Address </label>
                            <textarea class="form-control" rows="3"> Address val</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold"> About Shelter </label>
                            <textarea class="form-control" rows="5"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                Save Changes
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
