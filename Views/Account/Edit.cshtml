@{
    ViewData["Title"] = "Edit Profile";
}
<style>
    .btn-save {
        background-color: #2f3e34;
        color: #ffffff;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    }
    .btn-save:hover {
        background-color: #1f2d24;
        border-color: #1f2d24;
        color: #ffffff;
    }
    .btn-cancel {
        background-color: transparent;
        color: #2f3e34;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    } 
    .btn-cancel:hover {
        background-color: #2f3e34;
        color: #ffffff;
    }
</style>
<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-4">Edit Profile</h2>
            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
        <hr />

        <form>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">First Name</label>
                    <input type="text" class="form-control" value="Placeholder Name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Middle Name</label>
                    <input type="text" class="form-control" value="Placeholder Name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Last Name</label>
                    <input type="text" class="form-control" value="Placeholder Name" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Email</label>
                    <input type="email" class="form-control" value="Placeholder Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Contact Number</label>
                    <input type="text" class="form-control" value="Placeholder Contact Number" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Role</label>
                    <input type="text" class="form-control" value="Placeholder Role" disabled />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-save">
                    Save Changes
                </button>
            
                <a asp-controller="Account" asp-action="Index" class="btn btn-cancel">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
