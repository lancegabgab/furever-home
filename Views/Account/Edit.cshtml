@model FureverHome.ViewModels.AccountViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-4">Edit Profile</h2>
            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
        <hr />

        <form>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">First Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" value="@Model.FirstName" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Middle Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" value="@Model.MiddleName" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Last Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" value="@Model.LastName" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" value="@Model.Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Contact Number <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" value="@Model.ContactNumber" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Role</label>
                    <input type="text" class="form-control" value="@Model.Role" disabled />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-brand">
                    Save Changes
                </button>
            
                <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
