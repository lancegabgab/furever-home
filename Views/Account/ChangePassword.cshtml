@{
    ViewData["Title"] = "Change Password";
}
<style>
    .btn-primary-theme {
        background-color: #2f3e34;
        color: #ffffff;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    }

    .btn-primary-theme:hover {
        background-color: #1f2d24;
        border-color: #1f2d24;
        color: #ffffff;
    }

    .btn-outline-theme {
        background-color: transparent;
        color: #2f3e34;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    }

    .btn-outline-theme:hover {
        background-color: #2f3e34;
        color: #ffffff;
    }
</style>

<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-4">Change Password</h2>

            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-theme">
                Back
            </a>
        </div>

        <hr />

        <form method="post">

            <div class="mb-3">
                <label class="form-label fw-bold">Current Password</label>
                <input type="password" class="form-control" placeholder="Enter your current password" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">New Password</label>
                <input type="password" class="form-control" placeholder="Enter your new password" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Confirm New Password</label>
                <input type="password" class="form-control" placeholder="Confirm your new password" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary-theme">
                    Update Password
                </button>

                <a asp-controller="Account" asp-action="Index" class="btn btn-outline-theme">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>
