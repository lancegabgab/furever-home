@model FureverHome.ViewModels.AccountViewModel

@{
    ViewData["Title"] = "My Account";
}
<div class="container">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-4">My Profile</h2>
            <a asp-controller="Account" asp-action="Edit" class="btn btn-outline-secondary">
                Edit Profile
            </a>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-9 mb-3">
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Name</div>
                    <div class="col-sm-9">
                        @Model.FirstName
                        @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                        {
                            @($" {Model.MiddleName}")
                        }
                        @($" {Model.LastName}")
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Email</div>
                    <div class="col-sm-9">@Model.Email</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Contact Number</div>
                    <div class="col-sm-9">@Model.ContactNumber</div>
                </div>

                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Role</div>
                    <div class="col-sm-9">@Model.Role</div>
                </div>
            </div>
        </div>
        <div class="mt-4">
            <h5>Shelter Management</h5>
            <p class="text-muted">
                Create your own shelter or join an existing shelter community.
            </p>
            <div class="d-flex gap-2">
                <a asp-controller="Shelter" asp-action="Create" class="btn btn-brand">
                    Register a Shelter
                </a>
    
                <a asp-controller="Shelter" asp-action="Join" class="btn btn-brand-outline">
                    Join a Shelter
                </a>
            </div>
        </div>
        <div class="mt-4">
            <h5>Account Settings</h5>
            <div class="d-flex gap-2">
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-brand">
                    Change Password
                </a>
            </div>
        </div>
    </div>
</div>
