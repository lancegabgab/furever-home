@{
    ViewData["Title"] = "My Account";
}
<style>
    .btn-register-shelter {
        background-color: #2f3e34;
        color: #ffffff;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    }
    .btn-register-shelter:hover {
        background-color: #1f2d24;
        border-color: #1f2d24;
        color: #ffffff;
    }
    .btn-join-shelter {
        background-color: transparent;
        color: #2f3e34;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    } 
    .btn-join-shelter:hover {
        background-color: #2f3e34;
        color: #ffffff;
    }
</style>
<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <h2 class="mb-4">My Profile</h2>
        <hr />

        <div class="mb-3">
            <p><strong>Name:</strong> </p>
            <p><strong>Role:</strong> </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Shelter" asp-action="Create" class="btn btn-register-shelter">
                Register a Shelter
            </a>

            <a asp-controller="Shelter" asp-action="Join" class="btn btn-join-shelter">
                Join a Shelter
            </a>
        </div>
    </div>
</div>
