@{
    ViewData["Title"] = "My Account";
}
<style>
    .btn-primary-theme {
        background-color: #2f3e34;
        color: #ffffff;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    }
    .btn-primary-theme:hover {
        background-color: #1f2d24;
        border-color: #1f2d24;
        color: #ffffff;
    }
    .btn-outline-theme {
        background-color: transparent;
        color: #2f3e34;
        border: 1px solid #2f3e34;
        transition: all 0.2s ease;
        font-weight: 500;
    } 
    .btn-outline-theme:hover {
        background-color: #2f3e34;
        color: #ffffff;
    }
</style>
<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-4">My Profile</h2>
            <a asp-controller="Account" asp-action="Edit" class="btn btn-outline-secondary">
                Edit Profile
            </a>
        </div>
        <hr />

        <div class="mb-3">
            <div class="row mb-2">
                <div class="col-sm-3 fw-bold">Name</div>
                <div class="col-sm-9">Placeholder Name</div>
            </div>

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold">Email</div>
                <div class="col-sm-9">Placeholder Email</div>
            </div>

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold">Contact Number</div>
                <div class="col-sm-9">Placeholder Contact Number</div>
            </div>

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold">Role</div>
                <div class="col-sm-9">Placeholder Role</div>
            </div>
        </div>
        <div class="mt-4">
            <h5>Shelter Management</h5>
            <p class="text-muted">
                Create your own shelter or join an existing shelter community.
            </p>
            <div class="d-flex gap-2">
                <a asp-controller="Shelter" asp-action="Create" class="btn btn-primary-theme">
                    Register a Shelter
                </a>
    
                <a asp-controller="Shelter" asp-action="Join" class="btn btn-outline-theme">
                    Join a Shelter
                </a>
            </div>
        </div>
        <div class="mt-4">
            <h5>Account Settings</h5>
            <div class="d-flex gap-2">
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-primary-theme">
                    Change Password
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-theme">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
